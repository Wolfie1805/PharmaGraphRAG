# NCBI E-utilities Configuration
# Optional: NCBI API key allows up to 10 requests/second (default is 3 req/s without key).
# Leave empty if you do not have an API key.
NCBI_API_KEY=

# Required by NCBI policy: Contact email address for programmatic queries
NCBI_EMAIL=

# Required by NCBI policy: Application name identifier
NCBI_TOOL=PharmaGraph

