# PharmaGraph Environment Configuration
NCBI_API_KEY=
NCBI_EMAIL=
NCBI_TOOL=PharmaGraph

# Answer Mode Configuration (Phase D2)
# Options: extractive (default, free & fully offline), ollama (optional local model), mock (tests only)
LLM_MODE=extractive

# Optional Ollama Configuration (only used if LLM_MODE=ollama)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3
LLM_TIMEOUT_SECONDS=180
LLM_ALLOW_NON_LOCALHOST=false
